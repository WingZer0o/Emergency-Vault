{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/backend/src/EmergencyVault.Api/bin/Debug/net10.0/EmergencyVault.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/src/EmergencyVault.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5231"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "Docker: Attach to api (docker compose)",
            "type": "coreclr",
            "request": "attach",
            "processName": "EmergencyVault.Api",
            "pipeTransport": {
                "pipeProgram": "docker",
                "pipeArgs": ["exec", "-i", "application-api-1"],
                "debuggerPath": "/vsdbg/vsdbg",
                "pipeCwd": "${workspaceFolder}",
                "quoteArgs": false
            },
            "sourceFileMap": {
                "/src/src/EmergencyVault.Api": "${workspaceFolder}/backend/src/EmergencyVault.Api",
                "/src/src/EmergencyVault.Application": "${workspaceFolder}/backend/src/EmergencyVault.Application",
                "/src/src/EmergencyVault.Infrastructure": "${workspaceFolder}/backend/src/EmergencyVault.Infrastructure",
                "/src/src/EmergencyVault.Domain": "${workspaceFolder}/backend/src/EmergencyVault.Domain"
            },
            "justMyCode": false
        },
        {
            "name": "Containers: .NET Launch",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "netCore": {
                "appProject": "${workspaceFolder}/backend/src/EmergencyVault.Api/EmergencyVault.Api.csproj"
            }
        }
    ]
}