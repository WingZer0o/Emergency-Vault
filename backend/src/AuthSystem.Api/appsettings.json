{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "AuthSystem",
    "Audience": "AuthSystem.Client",
    "KeyPath": "/keys/ecdsa-p521.pem",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Frontend": {
    "BaseUrl": "http://localhost"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost" ]
  }
}
